{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "karmo-client",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev", "--prefix", "client", "--", "--port", "3010"],
      "port": 3010,
      "autoPort": false
    },
    {
      "name": "karmo-client-3001",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev", "--prefix", "client", "--", "--port", "3001"],
      "port": 3001,
      "autoPort": false
    },
    {
      "name": "karmo-backend",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "start:dev", "--prefix", "backend"],
      "port": 5000,
      "autoPort": false
    },
    {
      "name": "karmo-reference",
      "runtimeExecutable": "node",
      "runtimeArgs": [".claude/static-server.js", "recource/Karmo Website"],
      "port": 5501,
      "autoPort": true
    }
  ]
}
